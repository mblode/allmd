{
  "name": "allmd-monorepo",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "lint:fix": "turbo lint:fix",
    "format": "turbo format",
    "format:check": "turbo format:check",
    "check-types": "turbo check-types",
    "typecheck": "turbo check-types",
    "test": "turbo test",
    "test:e2e": "npm --workspace allmd run test:e2e",
    "test:e2e:live": "npm --workspace allmd run test:e2e:live",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "prepare": "lefthook install || true",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "release": "turbo build --filter=allmd && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "lefthook": "^2.1.10",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.73.0",
    "turbo": "^2.10.4",
    "ultracite": "7.9.3"
  },
  "overrides": {
    "tmp": "^0.2.7"
  },
  "packageManager": "npm@11.9.0"
}
