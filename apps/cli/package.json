{
  "name": "allmd",
  "version": "2.0.0",
  "description": "CLI tool to convert various content types to markdown",
  "keywords": [
    "cli",
    "converter",
    "markdown",
    "pdf",
    "web",
    "youtube"
  ],
  "homepage": "https://allmd.blode.co",
  "bugs": {
    "url": "https://github.com/mblode/allmd/issues"
  },
  "license": "MIT",
  "author": "Matthew Blode",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mblode/allmd.git",
    "directory": "apps/cli"
  },
  "bin": {
    "allmd": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE.md"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "start": "node dist/cli.js",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "npm run build && node --test e2e/*.e2e.mjs",
    "test:e2e:live": "ALLMD_E2E_LIVE=1 npm run test:e2e",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check ."
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.11",
    "@clack/prompts": "^1.7.0",
    "@mendable/firecrawl-js": "^4.30.0",
    "adm-zip": "^0.6.0",
    "ai": "^7.0.22",
    "chalk": "^5.6.2",
    "clipboardy": "^5.3.1",
    "commander": "^15.0.0",
    "cosmiconfig": "^9.0.2",
    "dotenv": "^17.4.2",
    "epub2": "^3.0.2",
    "fast-glob": "^3.3.3",
    "ffmpeg-static": "^5.3.0",
    "gray-matter": "^4.0.3",
    "mammoth": "^1.12.0",
    "openai": "^6.46.0",
    "ora": "^9.4.1",
    "p-limit": "^7.3.0",
    "pdf-parse": "^2.4.5",
    "rss-parser": "^3.13.0",
    "tabtab": "^3.0.2",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "update-notifier": "^7.3.1",
    "youtube-transcript": "^1.3.1"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^26.1.1",
    "@types/turndown": "^5.0.6",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.73.0",
    "tsup": "^8.5.1",
    "typescript": "6.0.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=24"
  }
}
